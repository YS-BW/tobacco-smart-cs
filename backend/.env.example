# LLM 已锁死在 config.py（本地 Ollama tobacco-csa:latest），无需配置

# MinerU（兜底解析器，markitdown 失败时使用，云端 API）
MINERU_TOKEN=your_mineru_token_here

# DashScope（Embedding + Reranker）
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_EMBEDDING_BATCH_SIZE=10
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# RAG 参数
RAG_RETRIEVAL_TOP_K=6
RAG_RERANK_TOP_K=3
RAG_RERANK_THRESHOLD=0.0

# 模型预热
MODEL_WARMUP_ENABLED=true
